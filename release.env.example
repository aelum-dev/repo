# ─────────────────────────────────────────────────────────────────────────────
# Secrets for publish-repo.sh — LOCAL ONLY.
#
# 1. Copy this file:            cp release.env.example release.env
# 2. Fill in your values.
# 3. Commit nothing — release.env is gitignored (see .gitignore).
#
# Same variable names as docker/release.env, so a release machine can keep
# both files side by side with the same values.
# ─────────────────────────────────────────────────────────────────────────────

# --- Cloudflare R2 (the existing "aelum" bucket; the repo lives under repo/) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# Optional overrides (defaults shown):
# R2_BUCKET=aelum
# R2_PUBLIC_BASE=https://cdn.aelum.dev

# --- The key that signs the database and the packages ---
# Key id or "Name <email>", as `gpg --list-secret-keys --keyid-format=long`
# prints it. This is the same release key that signs the ISOs (published via
# WKD at aelum.dev/.well-known/openpgpkey/).
AELUM_GPG_KEY=

# --- Headless signing (any machine without your keyring) ---
# The armored PRIVATE key, base64-encoded, and its passphrase.
AELUM_GPG_PRIVATE_KEY_B64=
GPG_PASSPHRASE=
